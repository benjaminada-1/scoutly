# Copy this file to .env, then configure ONE provider.
# Never commit .env or share your key publicly.
PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# If PROVIDER=openrouter, fill this key instead.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.8-flash

# Default is local only. Protect the app with authentication and rate limiting
# before exposing it to other people.
HOST=127.0.0.1
PORT=3000

